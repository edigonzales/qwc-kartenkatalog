# Copy to .env to override. Relative paths are resolved from the repository root.
QWC_IMAGE=sogis/qwc-kartenkatalog:latest
CATALOG_IMAGE=sogis/kartenkatalog:0.2.77-jvm
# Also used by npm run dev for the host Webpack server.
QWC_PORT=8082
CATALOG_PORT=8083
CATALOG_XTF_PATH=./data/kartenkatalog-harvest-ohne-qml.xtf
